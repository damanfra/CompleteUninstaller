<Window x:Class="CompleteUninstaller.App.Views.QuarantineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quarentena"
        Width="1120" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Quarentena" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                       Text="Cada limpeza fica guardada aqui até você excluí-la. Restaurar devolve pastas, arquivos, atalhos, tarefas agendadas e serviços aos lugares de origem." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DataGrid Grid.Column="1" Margin="12,0,0,0"
                      ItemsSource="{Binding SelectedEntries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding KindText}" Width="115" />
                    <DataGridTextColumn Header="Item" Binding="{Binding Target}" Width="2*" />
                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusText}" Width="1.2*" />
                    <DataGridTextColumn Header="Observação" Binding="{Binding Error}" Width="1.2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fechar" Click="Close_Click" Padding="20,6" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Restaurar" Command="{Binding RestoreCommand}" Style="{DynamicResource AccentButtonStyle}"
                        Padding="18,6" Margin="0,0,8,0" />
                <Button Content="Excluir definitivamente" Command="{Binding PurgeCommand}" Padding="16,6" Margin="0,0,8,0" />
                <Button Content="Abrir pasta" Command="{Binding OpenFolderCommand}" Padding="16,6" Margin="0,0,8,0" />
                <Button Content="Atualizar" Command="{Binding RefreshCommand}" Padding="16,6" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
