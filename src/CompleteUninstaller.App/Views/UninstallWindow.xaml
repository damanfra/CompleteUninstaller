<Window x:Class="CompleteUninstaller.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/app.ico"
        Title="{Binding Title}"
        Width="1080" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding App.DisplayName}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- ============ 1. Opções ============ -->
        <Grid Grid.Row="1" Visibility="{Binding IsOptionsStep, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Nível de limpeza" Style="{StaticResource SectionTitle}" />

                    <RadioButton GroupName="Level" IsChecked="{Binding IsSafe}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Seguro" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Executa o desinstalador oficial e procura só sobras com ligação comprovada ao programa: a pasta de instalação registrada, pastas com o nome exato dele, atalhos que apontam para ele, e serviços e tarefas agendadas que executam arquivos da pasta dele." />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Level" IsChecked="{Binding IsModerate}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Moderado" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Tudo do nível Seguro, mais itens encontrados por semelhança de nome (pastas de dados, atalhos quebrados, serviços e tarefas). Esses itens extras vêm desmarcados para você revisar um a um." />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="Opções" Style="{StaticResource SectionTitle}" />
                    <CheckBox IsChecked="{Binding CreateRestorePoint}" Margin="0,0,0,8"
                              Content="Criar um ponto de restauração do sistema antes de começar" />
                    <CheckBox IsChecked="{Binding PreferQuiet}" IsEnabled="{Binding HasQuietOption}" Margin="0,0,0,8"
                              Content="Usar a desinstalação silenciosa, quando o programa oferecer" />
                    <CheckBox IsChecked="{Binding SkipUninstaller}" Margin="0,0,0,16"
                              Content="Não executar o desinstalador (o programa já foi removido; só procurar sobras)" />

                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Nada é apagado direto: pastas, arquivos e atalhos vão para a quarentena, e serviços e tarefas têm a configuração guardada antes de serem excluídos. Tudo pode ser restaurado depois pelo botão Quarentena. A limpeza do Registro fica para a próxima fase do projeto." />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" Click="Close_Click" Padding="18,6" Margin="0,0,8,0" />
                <Button Content="Iniciar" Command="{Binding StartCommand}" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" Padding="24,6" />
            </StackPanel>
        </Grid>

        <!-- ============ 2. Em andamento ============ -->
        <Grid Grid.Row="1" Visibility="{Binding IsWorkingStep, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding WorkingText}" Style="{StaticResource SectionTitle}" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,12" />
                <TextBlock Style="{StaticResource Muted}"
                           Visibility="{Binding IsWaitingUninstaller, Converter={StaticResource BoolToVis}}"
                           Text="Siga as instruções na janela do desinstalador. Se ele terminar mas esta tela continuar esperando (por exemplo, porque abriu uma página no navegador), clique em &quot;O desinstalador já terminou&quot;." />
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Margin="0,12,0,0"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" />

            <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,6"
                    Content="O desinstalador já terminou"
                    Command="{Binding StopWaitingCommand}"
                    Visibility="{Binding IsWaitingUninstaller, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ============ 3. Revisão das sobras ============ -->
        <Grid Grid.Row="1" Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Só confiança alta" Command="{Binding SelectHighCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Marcar todos" Command="{Binding SelectAllCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Desmarcar todos" Command="{Binding SelectNoneCommand}" Padding="12,4" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Sobras encontradas" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding ReviewSummary}" Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Leftovers}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="44" SortMemberPath="IsSelected">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Confiança" Width="90" SortMemberPath="ConfidenceText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#9A6700" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                                    <Setter Property="Background" Value="#1A7F37" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ConfidenceText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Tipo" Binding="{Binding KindText}" Width="115" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="Item" Width="2.4*" SortMemberPath="Target">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
                                    <TextBlock Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               ToolTip="{Binding Details}"
                                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" SortMemberPath="SortSize" Width="85" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="Por que foi encontrado" Width="1.6*" SortMemberPath="Reason">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,3" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Não remover nada" Command="{Binding SkipCleanupCommand}" Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="Mover selecionados para a quarentena" Command="{Binding RemoveCommand}"
                            Style="{DynamicResource AccentButtonStyle}" Padding="20,6" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"
                           Text="Confiança alta: ligação comprovada com o programa. Média: encontrado pelo nome, confira antes." />
            </DockPanel>
        </Grid>

        <!-- ============ 4. Concluído ============ -->
        <Grid Grid.Row="1" Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding DoneTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding DoneSummary}" TextWrapping="Wrap" />
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0"
                        Visibility="{Binding NeedsReboot, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                               Text="Reinicie o computador para concluir: alguns itens estavam em uso e serão removidos na próxima inicialização." />
                </Border>
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Margin="0,14,0,0"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" />

            <Button Grid.Row="2" Content="Fechar" Click="Close_Click" HorizontalAlignment="Right"
                    Margin="0,14,0,0" Padding="24,6" Style="{DynamicResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
