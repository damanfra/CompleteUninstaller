<Window x:Class="CompleteUninstaller.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/app.ico"
        Title="Complete Uninstaller"
        Width="1320" Height="780" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Log" Command="{Binding OpenLogCommand}" Padding="14,6" Margin="0,0,8,0"
                        ToolTip="Abre a pasta com o registro de tudo o que foi feito" />
                <Button Content="Quarentena" Command="{Binding OpenQuarantineCommand}" Padding="14,6" Margin="0,0,8,0"
                        ToolTip="Ver, restaurar ou excluir definitivamente itens removidos" />
                <Button Content="Atualizar lista" Command="{Binding RefreshCommand}" Padding="14,6" Margin="0,0,8,0" />
                <Button Content="Atualizações" Click="CheckUpdates_Click" Padding="14,6"
                        ToolTip="Verifica se há uma versão nova do Complete Uninstaller no GitHub" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Programas instalados" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                           Text="Inclui o que o Painel de Controle não mostra: produtos do Windows Installer sem registro visível, componentes de sistema e apps da Store." />
            </StackPanel>
        </DockPanel>

        <!-- Busca e filtros -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Desinstalar…" Command="{Binding UninstallCommand}"
                    Style="{DynamicResource AccentButtonStyle}" Padding="20,6" FontWeight="SemiBold" />
            <Grid DockPanel.Dock="Left" Width="340">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="Pesquisar por nome ou fabricante" IsHitTestVisible="False" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <WrapPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <CheckBox Content="Ocultar itens do Windows" IsChecked="{Binding HideWindowsItems}" Margin="0,2,20,2"
                          ToolTip="Esconde apps que vêm com o Windows (Calculadora, Fotos, Edge, OneDrive...)" />
                <CheckBox Content="Ocultar apps da Microsoft" IsChecked="{Binding HideMicrosoftApps}" Margin="0,2,20,2"
                          ToolTip="Esconde tudo cujo fabricante é a Microsoft (Office, Visual Studio, runtimes...)" />
                <CheckBox Content="Apps da Store" IsChecked="{Binding ShowStoreApps}" Margin="0,2,20,2" />
                <CheckBox Content="Componentes de sistema" IsChecked="{Binding ShowSystemComponents}" Margin="0,2,20,2" />
                <CheckBox Content="Atualizações" IsChecked="{Binding ShowUpdates}" Margin="0,2,0,2" />
            </WrapPanel>
        </DockPanel>

        <!-- Lista + detalhes -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="AppsGrid"
                      ItemsSource="{Binding AppsView}"
                      SelectedItem="{Binding SelectedApp}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      CanUserResizeRows="False"
                      EnableRowVirtualization="True"
                      MouseDoubleClick="AppsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="36" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2.2*" />
                    <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="110" />
                    <DataGridTextColumn Header="Fabricante" Binding="{Binding Publisher}" Width="1.2*" />
                    <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" SortMemberPath="SortSize" Width="90" />
                    <DataGridTextColumn Header="Instalado em" Binding="{Binding InstallDate, StringFormat=dd/MM/yyyy}" Width="105" />
                    <DataGridTextColumn Header="Origem" Binding="{Binding Source}" Width="135" />
                    <DataGridTextColumn Header="Observações" Binding="{Binding Tags}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Selecione um programa para ver os detalhes."
                               Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedApp}">
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="32" Height="32" Margin="0,2,12,0"
                                       VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Tags}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />

                            <TextBlock Text="Versão" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Version, Mode=OneWay}" Style="{StaticResource FieldValue}" />

                            <TextBlock Text="Origem" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Source, Mode=OneWay}" Style="{StaticResource FieldValue}" />

                            <TextBlock Text="Pasta de instalação" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InstallLocation, Mode=OneWay}" Style="{StaticResource FieldValue}" />

                            <TextBlock Text="Comando de desinstalação" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UninstallString, Mode=OneWay}" Style="{StaticResource FieldValue}" />

                            <TextBlock Text="Desinstalação silenciosa" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding QuietUninstallString, Mode=OneWay}" Style="{StaticResource FieldValue}" />

                            <TextBlock Text="Chave do Registro" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding RegistryKey, Mode=OneWay}" Style="{StaticResource FieldValue}" />

                            <TextBlock Text="Código do produto (MSI)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProductCode, Mode=OneWay}" Style="{StaticResource FieldValue}" />

                            <TextBlock Text="Pacote (Store/MSIX)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding PackageName, Mode=OneWay}" Style="{StaticResource FieldValue}" />

                            <Button Content="Abrir pasta de instalação" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="12,5"
                                    Command="{Binding DataContext.OpenInstallLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de status -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="12"
                       Margin="16,0,0,0" VerticalAlignment="Center" />
            <ProgressBar DockPanel.Dock="Right" Width="160" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
